# ------------------------------------------------------------
# TUTOLAR · plantilla de entorno
# Copia este archivo a .env y ajusta lo que necesites.
#   cp .env.example .env      (o `copy .env.example .env` en Windows)
#   php artisan key:generate
# ------------------------------------------------------------

APP_NAME=TUTOLAR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Madrid
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ------------------------------------------------------------
# Base de datos · elige UNA de las dos
# ------------------------------------------------------------
#
# Opcion 1 · SQLite (por defecto). No necesita servidor: la base de
# datos es un archivo dentro del propio proyecto. Es lo que usa el
# entorno de desarrollo, asi que es lo que viene descomentado.
# Ajusta la ruta si el proyecto no esta en C:\xampp\htdocs\SORA.
DB_CONNECTION=sqlite
DB_DATABASE=C:\xampp\htdocs\SORA\TUTOLAR\database\database.sqlite

# Opcion 2 · MySQL/MariaDB de XAMPP (root sin contrasena).
# Comenta las dos lineas de arriba antes de descomentar estas.
#
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tutolar
# DB_USERNAME=root
# DB_PASSWORD=
#
# Con Docker no hace falta tocar nada: docker-compose.yml define sus
# propias DB_* y esas ganan sobre este archivo dentro del contenedor.

# En un ordenador compartido de secretaria conviene una sesion corta.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@tutolar.local"
MAIL_FROM_NAME="${APP_NAME}"
